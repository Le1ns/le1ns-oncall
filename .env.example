ONCALL_HTTP_ADDR=:8080
ONCALL_PUBLIC_BASE_URL=http://localhost:8080
ONCALL_GRAFANA_URL=http://grafana:3000
# Use one auth option for Grafana users API:
# 1) service token (recommended for real envs)
ONCALL_GRAFANA_SERVICE_TOKEN=
# 2) basic auth login:password (convenient for local dev)
ONCALL_GRAFANA_BASIC_AUTH=admin:admin
ONCALL_ALERTMANAGER_ALLOWED_SEVERITIES=*
ONCALL_ALERTMANAGER_MAX_ALERTS_PER_GROUP=20
ONCALL_ALERTMANAGER_RATE_WINDOW=10m
ONCALL_ALERTMANAGER_MAX_ALERTS_PER_WEBHOOK=100
ONCALL_JIRA_BASE_URL=http://jira-mock:8081
ONCALL_JIRA_EMAIL=oncall-admin@example.com
ONCALL_JIRA_API_TOKEN=dev-jira-token
ONCALL_JIRA_PROJECT_KEY=OPS
ONCALL_JIRA_ISSUE_TYPE=Task
ONCALL_TELEGRAM_BOT_TOKEN=
ONCALL_TELEGRAM_CHAT_ID=
ONCALL_TELEGRAM_CHAT_MAPPING=
ONCALL_LARK_WEBHOOK_URL=

POSTGRES_DB=oncall
POSTGRES_USER=oncall
POSTGRES_PASSWORD=oncall
